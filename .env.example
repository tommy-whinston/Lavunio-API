DATABASE_URL=postgres://lavunio:lavunio@localhost:5432/lavunio
HOST=127.0.0.1
PORT=8080
PUBLIC_BASE_URL=http://127.0.0.1:8080
STORAGE_KIND=local
STORAGE_DIR=./data/uploads
LAVUNIO_BOOTSTRAP_TOKEN=
LAVUNIO_DEV_MODE=0
LAVUNIO_ACCESS_TTL_SECS=900
LAVUNIO_REFRESH_TTL_SECS=2592000
LAVUNIO_EMAIL_TTL_SECS=900
LAVUNIO_RESET_TTL_SECS=3600
LAVUNIO_GAME_TTL_SECS=2592000
SKIN_DOMAINS=127.0.0.1,localhost
LAVUNIO_RATE_LIMIT_ENABLED=true
LAVUNIO_RATE_LIMIT_WINDOW_SECS=900
LAVUNIO_RATE_LIMIT_LOGIN=10
LAVUNIO_RATE_LIMIT_REGISTER=10
LAVUNIO_RATE_LIMIT_RESET=5
LAVUNIO_RATE_LIMIT_VERIFY=10
LOG_FORMAT=text
RUST_LOG=info,lavunio_api=debug

# S3 / Cloudflare R2 (used when STORAGE_KIND=s3)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_EXPIRES_SECS=3600
